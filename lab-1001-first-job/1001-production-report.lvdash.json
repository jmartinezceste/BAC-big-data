{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "kpis",
      "queryLines": [
        "SELECT count(DISTINCT date)       AS days_loaded,\n",
        "       count(DISTINCT park)       AS wind_farms,\n",
        "       count(DISTINCT turbine_id) AS turbines,\n",
        "       count(*)                   AS rows_loaded,\n",
        "       round(sum(energy_mwh), 1)  AS total_mwh\n",
        "FROM lab1001.bronze.production"
      ]
    },
    {
      "name": "by_farm",
      "displayName": "by_farm",
      "queryLines": [
        "SELECT CAST(date AS STRING) AS day, park, round(sum(energy_mwh), 1) AS energy_mwh\n",
        "FROM lab1001.bronze.production\n",
        "GROUP BY date, park"
      ]
    },
    {
      "name": "stopped",
      "displayName": "stopped",
      "queryLines": [
        "SELECT CAST(date AS STRING) AS day, park, turbine_id, operating_hours, energy_mwh\n",
        "FROM lab1001.bronze.production\n",
        "WHERE operating_hours < 24\n",
        "ORDER BY date, operating_hours"
      ]
    }
  ],
